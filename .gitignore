# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Secrets / environment (never commit these)
# ---------------------------------------------------------------------------
.env
.env.*
*.key
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Project data & runtime artifacts (regenerated by the pipeline)
# ---------------------------------------------------------------------------
# Raw HF download + cleaned parquet cache (regenerate: python -m data.loader)
data/cache/
# HuggingFace / torch model caches, if they land in-tree
.cache/
hf_cache/

# SQLite runtime DB (regenerate: python -m storage.db --backfill)
storage/*.db

# NOTE: intentionally KEPT in git (small, reproducible, let the dashboard run
# without re-running Laya):
#   data/splits/*.parquet        the seeded train/dev/test splits
#   storage/temperatures.json    fitted calibration temperatures
#   reports/evaluation_report.md the generated report
#   reports/predictions.parquet  cached eval predictions

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.log
.DS_Store
Thumbs.db
